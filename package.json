{
  "name": "pi-design-system",
  "version": "0.1.0",
  "description": "Pi Design System — tokens & components (SCSS). 前端切版對照用，不發布 npm。",
  "scripts": {
    "build": "sass resources/scss/index.scss dist/pi-ds.css --style=expanded --no-source-map",
    "build:min": "sass resources/scss/index.scss dist/pi-ds.min.css --style=compressed --no-source-map",
    "build:tokens": "sass resources/scss/tokens/index.scss dist/pi-ds-tokens.css --style=expanded --no-source-map",
    "watch": "sass --watch resources/scss/index.scss:dist/pi-ds.css --style=expanded --no-source-map",
    "lint:scss": "stylelint \"resources/scss/**/*.scss\"",
    "test": "npm run build && node scripts/check-build.mjs"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  },
  "keywords": [
    "design-system",
    "scss",
    "tokens",
    "pi"
  ],
  "license": "UNLICENSED",
  "private": true
}
