# 統一行尾為 LF，避免跨作業系統反覆污染 diff
* text=auto eol=lf

# 文字檔明確標記
*.html   text eol=lf
*.scss   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf

# 二進位檔，git 不得干涉
*.woff   binary
*.woff2  binary

# ============================================================
# Composer 套件出貨範圍
#
# 這裡才是決定「專案 composer require 之後 vendor/ 裡有什麼」的地方。
#
# 不要改用 composer.json 的 archive.exclude —— 那個欄位只作用於
# `composer archive` 指令。Composer 從 VCS repository 安裝時抓的是
# GitHub 的 zipball，而 GitHub 是用 `git archive` 產生它的，只認
# .gitattributes 的 export-ignore。寫在 archive.exclude 會完全沒效果。
#
# 驗證方式：git archive HEAD | tar -t
# ============================================================

# 開發工具與討論區，不進專案
/preview            export-ignore
/preview-static     export-ignore
/prototypes         export-ignore
/scripts            export-ignore
/.scratch           export-ignore
/.claude            export-ignore

# repo 自己的建置設定，下游用不到（下游用自己的 Vite / sass）
/package.json       export-ignore
/package-lock.json  export-ignore
/vite.config.js     export-ignore

# 實作規格與待辦，非交付內容
/design-guideline-spec.md  export-ignore
/TODO.md                   export-ignore

